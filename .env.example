REDIS_PASSWORD=your_redis_password_here
POSTGRES_USER=trackingtasks
POSTGRES_PASSWORD=your_postgres_password_here
POSTGRES_DB=TrackingTasksDb
GROQ_API_KEY=your_groq_api_key_here
# Cuenta de Gmail que manda el correo de "olvidé mi contraseña". EMAIL_PASSWORD es una
# contraseña de aplicación de 16 caracteres, no la contraseña normal de la cuenta (requiere
# verificación en dos pasos activada: myaccount.google.com → Seguridad → Contraseñas de aplicaciones).
EMAIL_USER=your_gmail_address_here
EMAIL_PASSWORD=your_gmail_app_password_here
TZ=America/Guayaquil
# Cifra el key ring guardado en la base (ver Docs/DataProtection.md). Dejar vacio = ring en
# claro dentro del pg_dump. Para activarlo: poner el .pfx en Deploy/keyring.pfx y descomentar.
# KEYRING_CERT_PATH=/keys/keyring.pfx
# KEYRING_CERT_PASSWORD=
