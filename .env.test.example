# Copiar a .env.test (chmod 600) en el server. Solo lo que cambia respecto de produccion:
# puertos del host, que no pueden chocar con el stack de produccion (5000/5432).
APP_PORT=5001
PG_PORT=5433
OP_PORT=8081

# Solo si OpenProject se publica con "tailscale serve" en vez de un tunel SSH: el host tiene
# que coincidir con el que ve el navegador, o OpenProject rechaza la peticion.
#   tailscale serve --bg --https=10000 http://127.0.0.1:8081
# OP_HOST_NAME=<host-del-tailnet>:10000
# OP_HTTPS=true

# Cadena larga cualquiera, p.ej. `openssl rand -hex 32`. Si cambia, se invalidan las
# sesiones de OpenProject.
OP_SECRET_KEY_BASE=

# El resto son las mismas variables de .env.example. Las credenciales pueden ser triviales:
# esta base es desechable y solo escucha en loopback.
REDIS_PASSWORD=test
POSTGRES_USER=trackingtasks
POSTGRES_PASSWORD=test
POSTGRES_DB=TrackingTasksDbTest
GROQ_API_KEY=
# El arranque exige ambas. Con valores falsos la app levanta igual; solo falla el correo
# de "olvide mi contrasena" si se prueba ese flujo.
EMAIL_USER=test@example.com
EMAIL_PASSWORD=test
TZ=America/Guayaquil
